{
  "name": "Mediola to MQTT",
  "version": "0.4.0",
  "slug": "mediola2mqtt",
  "init": false,
  "description": "Homeassistant interface to Mediola AIO Gateway v4/v4+",
  "arch": [
    "amd64"
  ],
  "services": [
    "mqtt:need"
  ],
  "ports": {
    "1902/udp": 1902,
    "1901/udp": 1901
  },
  "ports_description": {
    "1902/udp": "Status broadcasts of the v4/v4+ gateways",
    "1901/udp": "Status broadcasts of the v6 gateways"
  },
  "map": [
    "config"
  ],
  "options": {
    "mediola": {
      "host": "",
      "password": ""
    },
    "mqtt": {
      "host": "",
      "port": 1803,
      "username": "",
      "password": "",
      "discovery_prefix": "homeassistant",
      "topic": "mediola",
      "debug": false
    },
    "general": {
      "poll_interval": 0
    },
    "blinds": [],
    "buttons": []
  },
  "schema": {
    "mediola": {
      "host": "str",
      "password": "str"
    },
    "mqtt": {
      "host": "str",
      "port": "int(0,65535)",
      "username": "str",
      "password": "password",
      "discovery_prefix": "str",
      "topic": "str",
      "debug": "bool"
    },
    "general": {
      "poll_interval": "int(0,86400)?"
    },
    "blinds": [
      {
        "type": "match(ER|RT)?",
        "adr": "str?",
        "name": "str?",
        "device_class": "list(awning|blind|curtain|damper|door|garage|gate|shade|shutter|window)?",
        "travel_time_up": "float?",
        "travel_time_down": "float?",
        "intermediate_position": "bool?",
        "ventilation_position": "bool?"
      }
    ],
    "buttons": [
      {
        "type": "match(IT)?",
        "adr": "str?",
        "name": "str?"
      }
    ]
  }
}
